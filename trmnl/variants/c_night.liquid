{% comment %} Variant C "Night": dark theme, spare, one sentence and three quiet tiles. {% endcomment %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Familjen+Grotesk:wght@400;500;600&family=IBM+Plex+Mono:wght@500&display=swap">
<style>
.nt{position:absolute;inset:0;background:#000;color:#fff;font-family:'Familjen Grotesk',sans-serif;padding:48px 60px 40px;display:flex;flex-direction:column}
.nt .m{font-family:'IBM Plex Mono',monospace;font-weight:500;font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:#aaa}
.nt .top{display:flex;justify-content:space-between}
.nt .hero{display:flex;align-items:center;gap:28px;margin-top:40px}
.nt .face{width:184px;height:184px;border-radius:50%;background:#555;overflow:hidden;flex-shrink:0;display:flex;align-items:flex-end;justify-content:center}
.nt .face img{width:210px;filter:grayscale(1)}
.nt .name{font-weight:500;font-size:68px;line-height:1;letter-spacing:-.015em}
.nt .heat{margin-left:auto;width:120px;height:120px;border-radius:50%;border:2px solid #fff;display:flex;flex-direction:column;align-items:center;justify-content:center;flex-shrink:0}
.nt .heat b{font-weight:500;font-size:48px;line-height:1}
.nt .verdict{font-size:30px;line-height:1.3;color:#ddd;margin-top:34px;max-width:800px}
.nt .tiles{display:grid;grid-template-columns:repeat(3,1fr);margin-top:auto;border-top:1px solid #777}
.nt .t{padding:22px 20px 0 0;display:flex;gap:14px}
.nt .t+.t{padding-left:22px;border-left:1px solid #777}
.nt .t svg{width:28px;height:28px;fill:none;stroke:#fff;stroke-width:1.75;stroke-linecap:square;flex-shrink:0;margin-top:4px}
.nt .t b{display:block;font-weight:500;font-size:40px;line-height:1}
.nt .foot{display:flex;justify-content:space-between;margin-top:24px;font-size:18px;color:#bbb}
</style>
<div class="nt">
  <div class="top m"><span>Fantasy Scout · {{ label }}</span><span>{{ updated }}</span></div>
  <div class="hero">
    <div class="face">{% if img != '' %}<img class="image image-dither" src="{{ img }}" alt="">{% endif %}</div>
    <div>
      <div class="m" style="color:#fff">{{ action }} · {{ team }} {{ pos }}{% if tonight != '' %} · Tonight {{ tonight }}{% endif %}</div>
      <div class="name" style="margin-top:10px">{{ name }}</div>
    </div>
    <div class="heat"><b>{{ heat }}</b><span class="m" style="font-size:10px">Heat</span></div>
  </div>
  {% assign lead = claims | first %}<div class="verdict">{{ lead.h }}.</div>
  <div class="tiles">
    {% for c in claims %}{% assign e = c.ev | first %}
    <div class="t"><svg viewBox="0 0 24 24">{{ c.i }}</svg><div><b>{{ e.v }}</b><span class="m" style="font-size:11px">{{ e.l }}{% if e.p %} · {{ e.p }}th pct{% endif %}</span></div></div>
    {% endfor %}
  </div>
  <div class="foot"><span>{{ drop }}</span><span class="m" style="font-size:11px">{{ fpg }} pts/g proj</span></div>
</div>
