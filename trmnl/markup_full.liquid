{% comment %} Fantasy Scout :: TRMNL X (1040x780). Broadcast layout: story on the left; face and the move on the right; heat in the bar.
Type: Saira Semi Condensed is this plugin's voice; IBM Plex Mono / Plex Sans are the shared layer across the other plugins. {% endcomment %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Saira+Semi+Condensed:wght@500;600;700&family=IBM+Plex+Mono:wght@500&family=IBM+Plex+Sans:wght@400;500&display=swap">
<style>
.bc{position:absolute;inset:0;background:#fff;color:#000;font-family:'IBM Plex Sans',sans-serif;display:flex;flex-direction:column}
.bc .m{font-family:'IBM Plex Mono',monospace;font-weight:500;font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:#444}
.bc .s{font-family:'Saira Semi Condensed',sans-serif}
.bc .main{flex:1;display:flex;min-height:0;padding:40px 44px 28px 56px;gap:40px}
.bc .left{flex:1;display:flex;flex-direction:column;min-width:0}
.bc .kick{display:flex;align-items:center;gap:12px;margin-top:22px}
.bc .tag{border:1.5px solid #000;padding:4px 12px;color:#000}
.bc .act{font-weight:600;font-size:22px;letter-spacing:.04em;text-transform:uppercase}
.bc .name{font-weight:700;line-height:.95;text-transform:uppercase;margin-top:12px}
.bc .sub{font-size:19px;color:#333;margin-top:10px}
.bc .verdict{font-size:24px;line-height:1.34;margin-top:22px}
.bc .strip{display:grid;grid-template-columns:repeat(3,1fr);margin-top:auto;border-top:1.5px solid #000}
.bc .st{padding-top:16px;padding-right:12px}
.bc .st svg{width:24px;height:24px;fill:none;stroke:#000;stroke-width:1.75;stroke-linecap:square}
.bc .st b{display:block;font-weight:600;font-size:40px;line-height:1;margin-top:8px}
.bc .st .n{font-size:12px;color:#555;margin-top:3px}
.bc .right{width:320px;flex-shrink:0;display:flex;flex-direction:column;gap:18px}
.bc .face{flex:1;min-height:0;background:#e6e6e6;display:flex;align-items:flex-end;justify-content:center;overflow:hidden}
.bc .face img{height:100%;width:auto;max-width:none;display:block}
.bc .move{border:1.5px solid #000;padding:16px 18px 14px;flex-shrink:0}
.bc .row{display:flex;align-items:baseline;gap:12px;margin-top:10px}
.bc .row .k{width:34px}
.bc .row .who{flex:1;font-weight:600;font-size:24px;text-transform:uppercase;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.bc .row .v{font-weight:600;font-size:24px}
.bc .row.out .who,.bc .row.out .v{color:#777}
.bc .gain{display:flex;justify-content:space-between;align-items:baseline;border-top:1.5px solid #000;margin-top:12px;padding-top:10px}
.bc .gain b{font-weight:700;font-size:34px;line-height:1}
.bc .bar{height:64px;background:#000;color:#fff;display:flex;align-items:center;justify-content:space-between;padding:0 56px}
.bc .bar .m{color:#bbb}
.bc .ticks{display:flex;gap:4px}
.bc .ticks i{width:18px;height:10px;border:1.5px solid #fff;box-sizing:border-box}
.bc .ticks i.on{background:#fff}
.bc.hold .main{flex-direction:column;justify-content:center}
</style>

{% if mode == 'hold' %}
<div class="bc hold">
  <div class="main">
    <div class="m">Fantasy Scout · {{ updated }}</div>
    <div class="name s" style="font-size:150px;margin-top:30px">Hold</div>
    <div class="verdict" style="font-size:30px;max-width:760px">No move clears the bar today. Save your acquisitions.</div>
    {% if near %}<div class="m" style="margin-top:40px">{{ near }}</div>{% endif %}
  </div>
  <div class="bar"><span class="s" style="font-weight:600;font-size:24px">NOTHING WORTH A MOVE</span><span class="m">Fantasy Scout</span></div>
</div>
{% else %}
<div class="bc">
  <div class="main">
    <div class="left">
      <div class="m">Fantasy Scout · {{ updated }}</div>
      <div class="kick"><span class="tag m">{{ label }}</span><span class="act s">{{ action }}</span></div>
      <div class="name s" style="font-size:{% if name.size > 18 %}62px{% else %}74px{% endif %}">{{ name }}</div>
      <div class="sub">{{ team }} {{ pos }}{% if tonight != '' %} · Tonight {{ tonight }}{% endif %}</div>
      {% assign lead = claims | first %}<div class="verdict">{{ lead.h }}.</div>
      <div class="strip">
        {% for c in claims %}{% assign e = c.ev | first %}
        <div class="st">
          <div style="display:flex;align-items:center;gap:8px"><svg viewBox="0 0 24 24">{{ c.i }}</svg><span class="m" style="font-size:11px">{{ c.s }}</span></div>
          <b class="s">{{ e.v }}</b>
          <div class="m" style="font-size:11px;margin-top:4px">{{ e.l }}</div>
          {% if e.p %}<div class="n">{{ e.p }}th percentile</div>{% elsif e.n %}<div class="n">{{ e.n }}</div>{% endif %}
        </div>
        {% endfor %}
      </div>
    </div>
    <div class="right">
      <div class="face">{% if img != '' %}<img class="image image-dither" src="{{ img }}" alt="">{% endif %}</div>
      <div class="move">
        <div class="m" style="color:#000">The move</div>
        <div class="row"><span class="k m">In</span><span class="who s">{{ short }}</span><span class="v s">{{ fpg }}</span></div>
        {% if drop != '' %}
        <div class="row out"><span class="k m">Out</span><span class="who s">{{ drop }}</span><span class="v s">{{ drop_fpg }}</span></div>
        <div class="gain"><span class="m">Fpts / game</span><b class="s">{{ gain }}</b></div>
        {% else %}
        <div class="gain"><span class="m">Proj fpts / game</span><b class="s">{{ fpg }}</b></div>
        {% endif %}
      </div>
    </div>
  </div>
  <div class="bar">
    <div style="display:flex;align-items:center;gap:18px">
      <span class="m">Heat</span>
      <span class="s" style="font-weight:700;font-size:30px">{{ heat }}</span>
      {% assign lit = heat | divided_by: 10 %}<div class="ticks">{% for i in (1..10) %}<i class="{% if i <= lit %}on{% endif %}"></i>{% endfor %}</div>
    </div>
    <span class="m">{{ line }}</span>
  </div>
</div>
{% endif %}
