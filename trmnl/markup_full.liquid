{% comment %} Fantasy Scout :: TRMNL X (1040x780). Scouting-card layout, one move per day. mode = pick | hold. {% endcomment %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;700;800&family=Barlow:wght@500;600&display=swap">
<style>
.sc{position:absolute;inset:0;background:#fff;color:#000;font-family:'Barlow',sans-serif;display:flex;overflow:hidden}
.sc .rail{width:350px;flex-shrink:0;background:#000;color:#fff;display:flex;flex-direction:column;align-items:center;position:relative}
.sc .stripes{position:absolute;left:0;right:0;top:0;height:26px;background:repeating-linear-gradient(90deg,#fff 0 22px,#000 22px 34px)}
.sc .disc{margin-top:54px;width:270px;height:270px;border-radius:50%;background:#bbb;overflow:hidden;display:flex;align-items:flex-end;justify-content:center;border:6px solid #fff}
.sc .disc img{width:300px;filter:grayscale(1) contrast(1.15)}
.sc .disc .init{font-family:'Barlow Condensed';font-weight:800;font-size:120px;color:#000;margin:auto}
.sc .heat{margin-top:22px;font-family:'Barlow Condensed';font-weight:800;font-size:150px;line-height:.85}
.sc .heatlbl{font-family:'Barlow Condensed';font-weight:700;font-size:22px;letter-spacing:.3em;margin-top:6px}
.sc .ticks{display:flex;gap:4px;margin-top:12px}
.sc .tick{width:20px;height:12px;border:2px solid #fff;box-sizing:border-box}
.sc .tick.on{background:#fff}
.sc .stamp{margin-top:auto;margin-bottom:26px;border:4px solid #fff;padding:6px 18px;font-family:'Barlow Condensed';font-weight:800;font-size:34px;letter-spacing:.12em}
.sc .card{flex:1;min-width:0;display:flex;flex-direction:column;padding:30px 34px 22px}
.sc .top{display:flex;justify-content:space-between;align-items:baseline;font-family:'Barlow Condensed';font-weight:700;font-size:20px;letter-spacing:.18em}
.sc .verb{font-family:'Barlow Condensed';font-weight:800;font-size:40px;letter-spacing:.06em;text-transform:uppercase;margin-top:14px;line-height:1}
.sc .name{font-family:'Barlow Condensed';font-weight:800;text-transform:uppercase;line-height:.92;margin-top:2px}
.sc .chips{display:flex;gap:10px;margin-top:12px;flex-wrap:wrap}
.sc .chip{border:2.5px solid #000;padding:3px 12px;font-family:'Barlow Condensed';font-weight:700;font-size:22px;letter-spacing:.05em}
.sc .chip.inv{background:#000;color:#fff}
.sc .claims{margin-top:18px;display:flex;flex-direction:column;gap:14px;flex:1;min-height:0}
.sc .cl{display:flex;gap:16px;border-top:3px solid #000;padding-top:10px}
.sc .ck{width:104px;flex-shrink:0;font-family:'Barlow Condensed';font-weight:800;font-size:18px;letter-spacing:.14em;padding-top:3px}
.sc .cb{flex:1;min-width:0}
.sc .ch{font-size:23px;line-height:1.18;font-weight:600}
.sc .ev{display:flex;gap:26px;margin-top:6px}
.sc .e{min-width:0}
.sc .ev .v{font-family:'Barlow Condensed';font-weight:800;font-size:30px;line-height:1}
.sc .ev .l{font-family:'Barlow Condensed';font-weight:700;font-size:14px;letter-spacing:.1em;text-transform:uppercase;color:#333}
.sc .ev .n{font-size:13px;color:#444}
.sc .pb{width:90px;height:6px;background:#ddd;margin-top:3px;position:relative}
.sc .pb i{position:absolute;left:0;top:0;bottom:0;background:#000}
.sc .drop{display:flex;justify-content:space-between;align-items:center;margin-top:12px;font-family:'Barlow Condensed';font-weight:700;font-size:22px;letter-spacing:.04em}
.sc .foot{font-size:12px;color:#555;letter-spacing:.08em}
.sc.hold{background:#000;color:#fff;flex-direction:column;padding:0}
.sc.hold .body{padding:40px 54px;display:flex;flex-direction:column;flex:1}
.sc .big{font-family:'Barlow Condensed';font-weight:800;font-size:220px;line-height:.85;text-transform:uppercase;margin-top:40px}
</style>

{% if mode == 'hold' %}
<div class="sc hold">
  <div class="stripes" style="position:static"></div>
  <div class="body">
    <div class="top" style="color:#fff"><span>FANTASY SCOUT</span><span>{{ updated }}</span></div>
    <div class="big">Hold</div>
    <div style="font-size:34px;line-height:1.25;max-width:820px;color:#ddd;margin-top:18px">No move clears the bar today. Save your acquisitions.</div>
    {% if near %}<div style="margin-top:auto;border-top:3px solid #fff;padding-top:14px;font-family:'Barlow Condensed';font-weight:700;font-size:26px;letter-spacing:.04em">{{ near }}</div>{% endif %}
  </div>
</div>
{% else %}
<div class="sc">
  <div class="rail">
    <div class="stripes"></div>
    <div class="disc">{% if img != '' %}<img class="image image-dither" src="{{ img }}" alt="">{% else %}<span class="init">{{ name | slice: 0 }}</span>{% endif %}</div>
    <div class="heat">{{ heat }}</div>
    {% assign lit = heat | divided_by: 10 %}
    <div class="ticks">{% for i in (1..10) %}<div class="tick {% if i <= lit %}on{% endif %}"></div>{% endfor %}</div>
    <div class="heatlbl">HEAT</div>
    <div class="stamp">{{ label }}</div>
  </div>
  <div class="card">
    <div class="top"><span>FANTASY SCOUT</span><span>{{ updated }}</span></div>
    <div class="verb">{{ action }}</div>
    <div class="name" style="font-size:{% if name.size > 18 %}64px{% else %}78px{% endif %}">{{ name }}</div>
    <div class="chips">
      <span class="chip inv">{{ team }} · {{ pos }}</span>
      {% if tonight != '' %}<span class="chip">TONIGHT {{ tonight }}</span>{% endif %}
      <span class="chip">{{ fpg }} FPTS/G PROJ</span>
    </div>
    <div class="claims">
      {% for c in claims %}
      <div class="cl">
        <div class="ck">{{ c.k }}</div>
        <div class="cb">
          <div class="ch">{{ c.h }}</div>
          <div class="ev">
            {% for e in c.ev %}
            <div class="e">
              <div class="v">{{ e.v }}</div>
              <div class="l">{{ e.l }}{% if e.p %} · {{ e.p }}th pct{% endif %}</div>
              {% if e.p %}<div class="pb"><i style="width:{{ e.p }}%"></i></div>{% elsif e.n %}<div class="n">{{ e.n }}</div>{% endif %}
            </div>
            {% endfor %}
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
    <div class="drop">{% if drop != '' %}<span>{{ drop }}</span>{% endif %}<span class="foot">{{ line }}</span></div>
  </div>
</div>
{% endif %}
