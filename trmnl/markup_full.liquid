{% comment %} Fantasy Scout :: TRMNL X (1040x780). Scouting-card layout, one move per day. mode = pick | hold.
Type: Big Shoulders Display is this plugin's own voice; IBM Plex Mono / Plex Sans are the shared system layer used across the other plugins. {% endcomment %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;800;900&family=IBM+Plex+Mono:wght@500;600&family=IBM+Plex+Sans:wght@500;600&display=swap">
<style>
.sc{position:absolute;inset:0;background:#fff;color:#000;font-family:'IBM Plex Sans',sans-serif;display:flex;overflow:hidden}
.sc .d{font-family:'Big Shoulders Display',sans-serif;font-weight:900}
.sc .m{font-family:'IBM Plex Mono',monospace;font-weight:600;letter-spacing:.12em}
.sc .rail{width:340px;flex-shrink:0;background:#000;color:#fff;display:flex;flex-direction:column;align-items:center;position:relative}
.sc .stripes{position:absolute;left:0;right:0;top:0;height:24px;background:repeating-linear-gradient(90deg,#fff 0 22px,#000 22px 34px)}
.sc .disc{margin-top:48px;width:240px;height:240px;border-radius:50%;background:#bbb;overflow:hidden;display:flex;align-items:flex-end;justify-content:center;border:6px solid #fff}
.sc .disc img{width:270px;filter:grayscale(1) contrast(1.15)}
.sc .disc .init{font-size:110px;color:#000;margin:auto}
.sc .heat{margin-top:16px;font-size:132px;line-height:.82}
.sc .ticks{display:flex;gap:4px;margin-top:10px}
.sc .tick{width:20px;height:11px;border:2px solid #fff;box-sizing:border-box}
.sc .tick.on{background:#fff}
.sc .heatlbl{font-size:14px;margin-top:7px;letter-spacing:.3em}
.sc .icons{display:flex;gap:16px;margin-top:22px;padding-top:16px;border-top:2px solid #fff}
.sc .ic{display:flex;flex-direction:column;align-items:center;gap:6px;width:72px}
.sc .ic svg{width:44px;height:44px;fill:none;stroke:#fff;stroke-width:2.25;stroke-linecap:square;stroke-linejoin:miter}
.sc .ic span{font-size:11px;letter-spacing:.1em}
.sc .stamp{margin-top:auto;margin-bottom:22px;background:#fff;color:#000;padding:6px 18px 4px;font-size:34px;letter-spacing:.08em}
.sc .card{flex:1;min-width:0;display:flex;flex-direction:column;padding:28px 34px 20px}
.sc .top{display:flex;justify-content:space-between;font-size:14px;color:#333}
.sc .verb{font-size:36px;letter-spacing:.04em;text-transform:uppercase;margin-top:12px;line-height:1}
.sc .name{text-transform:uppercase;line-height:.88;margin-top:2px}
.sc .chips{display:flex;gap:10px;margin-top:12px;flex-wrap:wrap}
.sc .chip{border:2.5px solid #000;padding:3px 10px;font-size:14px}
.sc .chip.inv{background:#000;color:#fff}
.sc .claims{margin-top:16px;display:flex;flex-direction:column;gap:12px;flex:1;min-height:0}
.sc .cl{display:flex;gap:16px;border-top:3px solid #000;padding-top:10px}
.sc .ck{width:78px;flex-shrink:0;display:flex;flex-direction:column;align-items:flex-start;gap:4px}
.sc .ck svg{width:34px;height:34px;fill:none;stroke:#000;stroke-width:2.25;stroke-linecap:square;stroke-linejoin:miter}
.sc .ck span{font-size:11px}
.sc .cb{flex:1;min-width:0}
.sc .ch{font-size:22px;line-height:1.2;font-weight:600}
.sc .ev{display:flex;gap:26px;margin-top:6px}
.sc .ev .v{font-size:34px;line-height:1}
.sc .ev .l{font-size:11px;color:#333;margin-top:2px;text-transform:uppercase}
.sc .ev .n{font-size:12px;color:#444;font-family:'IBM Plex Mono',monospace}
.sc .pb{width:96px;height:6px;background:#ddd;margin-top:4px;position:relative}
.sc .pb i{position:absolute;left:0;top:0;bottom:0;background:#000}
.sc .drop{display:flex;justify-content:space-between;align-items:baseline;margin-top:10px}
.sc .drop b{font-size:26px;letter-spacing:.02em;text-transform:uppercase;white-space:nowrap}
.sc .foot{font-size:11px;color:#555;white-space:nowrap;margin-left:16px}
.sc.hold{background:#000;color:#fff;flex-direction:column}
.sc.hold .body{padding:44px 54px;display:flex;flex-direction:column;flex:1}
.sc .big{font-size:240px;line-height:.8;text-transform:uppercase;margin-top:40px}
</style>

{% if mode == 'hold' %}
<div class="sc hold">
  <div class="stripes" style="position:static"></div>
  <div class="body">
    <div class="top m" style="color:#ccc"><span>FANTASY SCOUT</span><span>{{ updated }}</span></div>
    <div class="big d">Hold</div>
    <div style="font-size:32px;line-height:1.3;max-width:820px;color:#ddd;margin-top:22px">No move clears the bar today. Save your acquisitions.</div>
    {% if near %}<div class="m" style="margin-top:auto;border-top:3px solid #fff;padding-top:14px;font-size:18px">{{ near }}</div>{% endif %}
  </div>
</div>
{% else %}
<div class="sc">
  <div class="rail">
    <div class="stripes"></div>
    <div class="disc">{% if img != '' %}<img class="image image-dither" src="{{ img }}" alt="">{% else %}<span class="init d">{{ name | slice: 0 }}</span>{% endif %}</div>
    <div class="heat d">{{ heat }}</div>
    {% assign lit = heat | divided_by: 10 %}
    <div class="ticks">{% for i in (1..10) %}<div class="tick {% if i <= lit %}on{% endif %}"></div>{% endfor %}</div>
    <div class="heatlbl m">HEAT</div>
    <div class="icons">{% for c in claims %}<div class="ic"><svg viewBox="0 0 24 24">{{ c.i }}</svg><span class="m">{{ c.s }}</span></div>{% endfor %}</div>
    <div class="stamp d">{{ label }}</div>
  </div>
  <div class="card">
    <div class="top m"><span>FANTASY SCOUT</span><span>{{ updated }}</span></div>
    <div class="verb d">{{ action }}</div>
    <div class="name d" style="font-size:{% if name.size > 18 %}72px{% else %}88px{% endif %}">{{ name }}</div>
    <div class="chips">
      <span class="chip inv m">{{ team }} · {{ pos }}</span>
      {% if tonight != '' %}<span class="chip m">TONIGHT {{ tonight }}</span>{% endif %}
      <span class="chip m">{{ fpg }} FPTS/G PROJ</span>
    </div>
    <div class="claims">
      {% for c in claims %}
      <div class="cl">
        <div class="ck"><svg viewBox="0 0 24 24">{{ c.i }}</svg><span class="m">{{ c.s }}</span></div>
        <div class="cb">
          <div class="ch">{{ c.h }}</div>
          <div class="ev">
            {% for e in c.ev %}
            <div>
              <div class="v d">{{ e.v }}</div>
              <div class="l m">{{ e.l }}{% if e.p %} · {{ e.p }}TH PCT{% endif %}</div>
              {% if e.p %}<div class="pb"><i style="width:{{ e.p }}%"></i></div>{% elsif e.n %}<div class="n">{{ e.n }}</div>{% endif %}
            </div>
            {% endfor %}
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
    <div class="drop">{% if drop != '' %}<b class="d">{{ drop }}</b>{% endif %}<span class="foot m">{{ line }}</span></div>
  </div>
</div>
{% endif %}
