{% comment %} Fantasy Scout :: TRMNL X (1040x780). One move per day. mode = pick | hold. {% endcomment %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,600&family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans:wght@400;600&display=swap">
<style>
.fs{position:absolute;inset:0;background:#fff;color:#000;font-family:'IBM Plex Sans',sans-serif;display:flex;flex-direction:column;overflow:hidden}
.fs .bar{height:58px;flex-shrink:0;background:#000;color:#fff;display:flex;align-items:center;justify-content:space-between;padding:0 30px;font-family:'IBM Plex Mono',monospace;font-size:19px;letter-spacing:.08em}
.fs .body{flex:1;display:flex;min-height:0}
.fs .main{flex:1;padding:28px 36px 24px;display:flex;flex-direction:column;gap:16px;min-width:0}
.fs .lbl{font-family:'IBM Plex Mono',monospace;font-size:15px;letter-spacing:.14em;color:#333}
.fs .tag{font-family:'IBM Plex Mono',monospace;font-size:17px;letter-spacing:.12em;background:#000;color:#fff;padding:3px 10px;font-weight:600}
.fs .action{font-family:'IBM Plex Mono',monospace;font-size:19px;letter-spacing:.06em}
.fs .name{font-family:'Newsreader',serif;font-weight:600;line-height:1;margin-top:2px}
.fs .meta{font-size:22px;color:#222;display:flex;gap:18px;flex-wrap:wrap}
.fs .meta b{font-weight:600}
.fs .heat{display:flex;align-items:center;gap:14px}
.fs .cells{display:flex;gap:5px}
.fs .cell{width:30px;height:22px;border:2.5px solid #000;box-sizing:border-box}
.fs .cell.on{background:#000}
.fs .heatnum{font-family:'IBM Plex Mono',monospace;font-size:26px;font-weight:600}
.fs .why{border-top:3px solid #000;padding-top:14px;font-family:'Newsreader',serif;font-size:28px;line-height:1.28}
.fs .line{font-family:'IBM Plex Mono',monospace;font-size:16px;letter-spacing:.03em;color:#222;margin-top:auto}
.fs .drop{background:#eee;padding:12px 16px;font-size:21px;display:flex;justify-content:space-between;align-items:center}
.fs .side{width:330px;flex-shrink:0;border-left:3px solid #000;padding:28px 24px 22px;box-sizing:border-box;display:flex;flex-direction:column;gap:14px}
.fs .stat{display:flex;flex-direction:column;gap:5px}
.fs .srow{display:flex;justify-content:space-between;align-items:baseline}
.fs .sl{font-family:'IBM Plex Mono',monospace;font-size:15px;letter-spacing:.06em;color:#333}
.fs .sv{font-size:24px;font-weight:600}
.fs .track{height:8px;border:2px solid #000;position:relative}
.fs .fill{position:absolute;left:0;top:0;bottom:0;background:#000}
.fs .pct{font-family:'IBM Plex Mono',monospace;font-size:12px;color:#444;text-align:right}
.fs .foot{margin-top:auto;font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:.05em;color:#444}
.fs.hold{background:#000;color:#fff;padding:40px 54px;gap:22px}
.fs .big{font-family:'Newsreader',serif;font-size:170px;line-height:.95}
</style>

{% if mode == 'hold' %}
<div class="fs hold">
  <div style="display:flex;justify-content:space-between;font-family:'IBM Plex Mono',monospace;font-size:19px;letter-spacing:.08em"><b>FANTASY SCOUT</b><span>{{ updated }}</span></div>
  <div class="big" style="margin-top:40px">Hold.</div>
  <div style="font-family:'Newsreader',serif;font-size:40px;line-height:1.25;max-width:820px;color:#ddd">No move clears the bar today. Keep your lineup and your acquisitions.</div>
  {% if near %}<div style="margin-top:auto;border-top:3px solid #fff;padding-top:16px;font-size:24px">{{ near }}</div>{% endif %}
</div>
{% else %}
<div class="fs">
  <div class="bar"><b>FANTASY SCOUT</b><span>ONE MOVE TODAY</span><span>{{ updated }}</span></div>
  <div class="body">
    <div class="main">
      <div style="display:flex;align-items:center;gap:14px"><span class="tag">{{ label }}</span><span class="action">{{ action }}</span></div>
      <div class="name" style="font-size:{% if name.size > 18 %}62px{% else %}76px{% endif %}">{{ name }}</div>
      <div class="meta"><span><b>{{ team }}</b> · {{ pos }}</span>{% if tonight != '' %}<span>Tonight {{ tonight }}</span>{% endif %}<span><b>{{ fpg }}</b> proj fpts/g</span></div>
      <div class="heat">
        <span class="lbl">HEAT</span>
        <div class="cells">{% assign lit = heat | divided_by: 10 %}{% for i in (1..10) %}<div class="cell {% if i <= lit %}on{% endif %}"></div>{% endfor %}</div>
        <span class="heatnum">{{ heat }}</span>
      </div>
      <div class="why">{{ why }}</div>
      {% if drop != '' %}<div class="drop"><span class="lbl" style="color:#000">TO MAKE ROOM</span><b>{{ drop }}</b></div>{% endif %}
      <div class="line">{{ line }}</div>
    </div>
    <div class="side">
      <div class="lbl">UNDER THE HOOD</div>
      {% for s in stats %}
      <div class="stat">
        <div class="srow"><span class="sl">{{ s.l }}</span><span class="sv">{{ s.v }}</span></div>
        {% if s.p %}<div class="track"><div class="fill" style="width:{{ s.p }}%"></div></div><div class="pct">{{ s.p }}th pct</div>{% endif %}
      </div>
      {% endfor %}
      <div class="foot">NHL · NHL EDGE · MONEYPUCK</div>
    </div>
  </div>
</div>
{% endif %}
